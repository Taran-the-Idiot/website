---
import '../styles/journey.css';
import '../styles/nav.css';
import '../styles/global.css';
import Layout from '../layouts/base.astro';

const frontmatter = {
  title: 'Tarans journey',
  heading: 'A record of everything I have done up til now'
};
---


<Layout frontmatter={frontmatter}>
  <main>
    <p>
        I usually forget what I have done in the past, so I am creating this page to keep a record of everything I have done up til now. Although some of the older stuff is a tad bit inaccurate cuz i forgor.
    </p>
    <div class="journey-list">
      <a href="https://counterspell.hackclub.com/sydney" class="journey-card" target="_blank">
        <h2>Counterspell Sydney</h2>
        <div>
            <p class="journey-description">I organised a 20 person game jam in Sydney in November of 2024</p>
            <p class="journey-date">23-24 November 2024</p>
        </div>
      </a>
      <a href="https://scrapyard.hackclub.com/sydney" class="journey-card" target="_blank">
        <h2>Scrapyard Sydney</h2>
        <div>
            <p class="journey-description">I organised a 100 person high school hackathon in Sydney in March of 2025</p>
            <p class="journey-date">15-16 March 2025</p>
        </div>
      </a>
      <a href="https://undercity.hackclub.com" class="journey-card" target="_blank">
        <h2>Undercity</h2>
        <div>
            <p class="journey-description">I attended a hardware hackathon at Github HQ in July 2025.</p>
            <p class="journey-date">9-12 July 2025</p>
        </div>
      </a>
      <a href="https://daydream.hackclub.com/sydney" class="journey-card" target="_blank">
        <h2>Daydream Sydney</h2>
        <div>
            <p class="journey-description">I organised a 150 person game jam in Sydney in September of 2025</p>
            <p class="journey-date">27-28 September 2025</p>
        </div>
      </a>
      <a href="https://ftcscout.org/teams/32134" class="journey-card" target="_blank">
        <h2>Same Day Delivery</h2>
        <div>
            <p class="journey-description">I started an FTC team at my school and we competed in the 2025 Decode season</p>
            <p class="journey-date">16 November 2025</p>
        </div>
      </a>
      <a href="https://campfire.hackclub.com" class="journey-card" target="_blank">
        <h2>Campfire</h2>
        <div>
            <p class="journey-description">I organised a global satellite hackathon in over 150 cities across the world!</p>
            <p class="journey-date">28 Feb - 1 March 2026</p>
        </div>
      </a>
    </div>
  </main>
</Layout>